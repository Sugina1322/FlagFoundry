client
dev tun
proto udp
remote {{VPN_HOST}} {{VPN_PORT}}
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
cipher AES-256-GCM
verb 3

# Assigned training subnet: {{USER_SUBNET}}
# Replace the inline certificate blocks during real PKI provisioning.
<ca>
PASTE_CA_CERTIFICATE_HERE
</ca>
<cert>
PASTE_CLIENT_CERTIFICATE_FOR_{{CLIENT_NAME}}_HERE
</cert>
<key>
PASTE_CLIENT_KEY_FOR_{{CLIENT_NAME}}_HERE
</key>

